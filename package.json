{
  "name": "ics-controlhub",
  "version": "1.0.0",
  "description": "ICS ControlHub - Internal Control & Operational Risk Monitoring Portal (Amex ICS Japan Market)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "seed": "node server/db.js",
    "test:api": "node server/test-api.js"
  },
  "keywords": [
    "internal-control",
    "operational-risk",
    "sod",
    "maker-checker",
    "amex-ics",
    "ccm"
  ],
  "author": "Antigravity Engineering",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
